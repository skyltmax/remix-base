{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Layer 1 (mechanical) config. Renovate detects pins, opens bump PRs and refreshes the lockfile; it knows nothing
  // about how we use any of it. The layer that decides what actually merges is the per-PR impact brief in
  // docs/upgrades/ (RUNBOOK.md → the gate, INTERACTIONS.md → this repo's landmines).
  extends: [
    "config:best-practices",
    "config:js-lib",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":label(dependencies)",
    ":timezone(Europe/Tallinn)",
    "schedule:weekly",
    ":approveMajorUpdates",
  ],

  packageRules: [
    // --- First-party packages: our own releases, no settle time ---
    // The inherited 3-day npm settle (security:minimumReleaseAgeNpm) exists so third-party releases can be scrutinised
    // before we pull them. Our own packages ship from reviewed sibling repos and exist to be validated here the day
    // they are cut, so the window buys nothing. pnpm-workspace.yaml carries the matching resolution-time exemption —
    // both layers are needed, since the settle Renovate applies does not govern lockfile maintenance (§7).
    {
      matchPackageNames: ["@signmax/**", "@skyltmax/**"],
      minimumReleaseAge: null,
      addLabels: ["first-party"],
    },

    // --- Harbor images: built in skyltmax/infra, tracked here ---
    // Tags carry <upstream>-<N> rebuild suffixes, which docker versioning would misread as a compatibility suffix —
    // regex versioning treats <N> as a build counter, so rails-4.0.6-30 -> rails-4.0.6-31 is an update. A wrong match
    // shows "no update" while new images keep publishing. The CHANGELOG_DISPLAYED_<N> marker in .devcontainer/boot.sh
    // still needs a manual commit on the PR (§2).
    {
      matchPackageNames: ["harbor.signmax.cloud/**"],
      groupName: "harbor images",
      addLabels: ["cross-repo/infra"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
    },
    // The devcontainer image prefixes its tags with the stack name (devcontainer:rails-4.0.6-30).
    {
      matchPackageNames: ["harbor.signmax.cloud/public/devcontainer"],
      versioning: "regex:^rails-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
    },
  ],
}
