{
  "name": "@signmax/remix-base",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "description": "Server and shared utils for React Router 8 projects",
  "license": "MIT",
  "author": "Signmax AB <team@signomatic.ee> (https://skyltmax.se/)",
  "homepage": "https://github.com/skyltmax/remix-base#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyltmax/remix-base.git"
  },
  "bugs": {
    "url": "https://github.com/skyltmax/remix-base/issues"
  },
  "keywords": [
    "remix",
    "react-router",
    "signmax",
    "skyltmax"
  ],
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./instrumentation": {
      "import": "./dist/instrumentation.js",
      "types": "./dist/instrumentation.d.ts"
    },
    "./router_context": {
      "import": "./dist/router_context.js",
      "types": "./dist/router_context.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    },
    "./metrics": {
      "import": "./dist/metrics.js",
      "types": "./dist/metrics.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./test/helpers": {
      "import": "./dist/test/helpers.js",
      "types": "./dist/test/helpers.d.ts"
    },
    "./util": {
      "import": "./dist/util/index.js",
      "types": "./dist/util/index.d.ts"
    },
    "./client": {
      "import": "./dist/api/client.js",
      "types": "./dist/api/client.d.ts"
    },
    "./secrets": {
      "import": "./dist/secrets.js",
      "types": "./dist/secrets.d.ts"
    },
    "./growthbook": {
      "import": "./dist/growthbook.js",
      "types": "./dist/growthbook.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/cloudfront-ips/*.json dist/cloudfront-ips/",
    "format": "prettier . --write",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "run-p -l format lint typecheck",
    "bump": "npx npm-check-updates --dep prod,dev,peer,optional --target latest -i",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "prettier": "@signmax/config/prettier",
  "devDependencies": {
    "@signmax/config": "3.0.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/set-cookie-parser": "2.4.10",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "msw": "2.15.0",
    "node-mocks-http": "1.18.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1112.0",
    "@nichtsam/helmet": "^0.3.3",
    "@tusbar/cache-control": "^3.0.1",
    "chalk": "^6.0.0",
    "close-with-grace": "^2.5.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "get-port": "^7.2.0",
    "graphql-request": "^7.4.0",
    "isbot": "^5.2.1",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "set-cookie-parser": "^3.1.2"
  },
  "peerDependencies": {
    "@react-router/express": "^8.3.0",
    "@sentry/profiling-node": "^10.70.0",
    "@sentry/react-router": "^10.70.0",
    "express": "^5.2.1",
    "react-router": "^8.3.0"
  },
  "optionalDependencies": {
    "@growthbook/growthbook": "^1.7.0",
    "eventsource": "^5.1.0"
  }
}
